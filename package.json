{
	"name": "website_rinrin",
	"version": "2.0.3",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run licenses && vite build",
		"build:deploy": "pnpm run project-dates && pnpm run build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . --log-level warn",
		"project-dates": "tsx assets/scripts/collect-project-dates.ts",
		"licenses": "node assets/scripts/collect-licenses.ts",
		"article": "tsx assets/scripts/create-article.ts",
		"artwork": "tsx assets/scripts/create-artwork.ts",
		"project": "tsx assets/scripts/create-project.ts"
	},
	"packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.2",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@quantco/pnpm-licenses": "^2.4.2",
		"@types/node": "^26.6.2",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-license": "^3.7.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"svelte-preprocess": "^6.0.5",
		"typescript-eslint": "^8.70.1"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/nprogress": "^0.2.3",
		"chart.js": "^4.5.1",
		"nprogress": "^0.2.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"sass": "^1.105.0",
		"shiki": "^4.4.3",
		"svelte": "^5.57.1",
		"svelte-chartjs": "^4.0.1",
		"svelte-french-toast": "^1.2.0",
		"svelte-i18n": "^4.0.1",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"uuid": "^14.0.2",
		"vite": "^8.3.0"
	}
}
